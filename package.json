{
  "name": "note-agent",
  "version": "0.2.1",
  "description": "Note Agent: bring-your-own LLM chat and agent for your vault, AI editing with diff preview, inline completion, prompts, semantic search and MCP.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sigmalos/Note-Agent.git"
  },
  "homepage": "https://github.com/sigmalos/Note-Agent#readme",
  "bugs": {
    "url": "https://github.com/sigmalos/Note-Agent/issues"
  },
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "seed": "npm run build && node scripts/deploy.mjs --seed"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "ai",
    "llm",
    "agent"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "happy-dom": "^15.11.7",
    "obsidian": "^1.14.4",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
