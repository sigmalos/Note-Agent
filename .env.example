# OpenAI 兼容服务地址（可不带 /v1，插件会自动补全 /v1/chat/completions）
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=sk-xxxx
# 可选：播种（npm run seed）时预先选中的模型，以及集成测试（npm run test:live）使用的模型 ID；
# 不填时插件会提示在对话框中选择模型（模型列表由 /models 自动检测）
MODEL_ID=deepseek-chat
# 可选：放进“最近使用”的模型，逗号分隔，例如 GLM-4.5-Flash,Qwen3.6-Flash
MODEL_IDS=
# 可选：测试仓库路径
OBSIDIAN_VAULT=~/Desktop/Projects/Agent-Vault
